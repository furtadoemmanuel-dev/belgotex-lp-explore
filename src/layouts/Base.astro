---
// Tipografia da LP Timberland (aprovada): DM Serif Display nos títulos, DM Sans no texto. São as substitutas
// livres da Publico Headline e da Circular Std, as fontes do catálogo Explore.
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-serif-display/400-italic.css';
import serifLatin from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import sansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { config } from '../config';
import { colors, colorName } from '../lib/data';
import ogSource from '../assets/ambientes/lobby-odyssey-403-frontier-203.jpg';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
const og = await getImage({
  src: ogSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 82,
});
const ogUrl = new URL(og.src, config.siteUrl).href;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Explore',
  description,
  brand: { '@type': 'Brand', name: 'Belgotex' },
  manufacturer: { '@type': 'Organization', name: 'Belgotex do Brasil', url: config.mainSiteUrl },
  category: 'Carpete modular em placas',
  image: ogUrl,
  url: canonical,
  material: '100% SDN – Solution Dyed Nylon (PA), Tufting Bouclê',
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Dimensões', value: '50 × 50 cm (5 m² por caixa)' },
    { '@type': 'PropertyValue', name: 'Altura total', value: '5,5 mm (± 10%)' },
    { '@type': 'PropertyValue', name: 'Aplicação (EN 1307)', value: '33 – Comercial pesado' },
    { '@type': 'PropertyValue', name: 'Paginação indicada', value: 'Tecelagem' },
  ],
  color: colors.map(colorName).join(', '),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {config.noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f7f3ec" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Belgotex do Brasil" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
    <!-- Consent Mode v2: tudo negado por padrão. O GTM só é carregado depois do aceite (src/scripts/consent.ts). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      // O Consent Mode exige o objeto arguments (não um array)
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <slot />
  </body>
</html>
