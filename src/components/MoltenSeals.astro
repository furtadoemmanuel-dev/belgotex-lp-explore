---
/**
 * Selos num anel "derretido" (adaptado do MoltenRingCarousel, sem React nem Tailwind; src/scripts/moltenring.ts).
 * O anel é bem maior que o palco e o centro fica à esquerda: só um arco passa pela tela, com um selo de frente.
 * Os cards são campos de distância desenhados num único passe WebGL2: vizinhos que se aproximam se fundem,
 * os que se afastam deixam um fio que afina e arrebenta. O mouse amolece o campo, inclina os cards e afasta
 * os vizinhos. Na chegada à tela, o baralho começa fundido num bloco e o anel o abre em fios.
 *
 * Sem WebGL2 (ou sem JavaScript), a mesma lista aparece como grade de cards comuns. Com o anel ativo, a lista
 * continua no HTML só para leitores de tela.
 */
interface Seal {
  src: string;
  label: string;
  group: string;
  text: string;
}
interface Props {
  seals: Seal[];
}
const { seals } = Astro.props;
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<div class="mr" data-molten data-seals={JSON.stringify(seals)}>
  <div class="mr-stage" aria-hidden="false">
    <canvas
      class="mr-canvas"
      tabindex="0"
      role="img"
      aria-label="Anel com os selos do Explore. Use as setas para girar."
      data-mr-canvas></canvas>
    <div class="mr-cap mr-cap--left" aria-hidden="true">
      <span class="mr-idx" data-mr-idx>01</span>
      <span class="mr-title" data-mr-title>{seals[0]?.label}</span>
    </div>
    <div class="mr-cap mr-cap--right" aria-hidden="true">
      <span class="mr-group" data-mr-group>{seals[0]?.group}</span>
      <span class="mr-text" data-mr-text>{seals[0]?.text}</span>
    </div>
    <div class="mr-nav">
      <button type="button" class="mr-btn" data-mr-step="-1" aria-label="Selo anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6"></path></svg>
      </button>
      <span class="mr-count" aria-hidden="true"><span data-mr-num>01</span> / {pad2(seals.length)}</span>
      <button type="button" class="mr-btn" data-mr-step="1" aria-label="Próximo selo">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg>
      </button>
    </div>
    <p class="sr-only" aria-live="polite" data-mr-live></p>
  </div>

  <ul class="mr-list" aria-label="Selos e certificações">
    {seals.map((s, i) => (
      <li>
        <img src={s.src} width="120" height="120" alt="" loading="lazy" decoding="async" />
        <span class="mr-li-idx">{pad2(i + 1)}</span>
        <strong>{s.label}</strong>
        <span class="mr-li-meta">{s.group}. {s.text}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .mr {
    position: relative;
    margin-block: clamp(1rem, 0.5rem + 2vw, 2.5rem) clamp(2rem, 1rem + 3vw, 4rem);
  }
  .mr-stage {
    display: none;
    position: relative;
    height: clamp(460px, 68vh, 640px);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }
  .mr.is-gl .mr-stage {
    display: block;
  }
  .mr-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #fff; /* silhueta enquanto as artes carregam */
    cursor: grab;
    touch-action: pan-y; /* no celular, arrastar para os lados gira; para cima e para baixo rola a página */
    outline: none;
  }
  .mr-canvas:active {
    cursor: grabbing;
  }
  .mr-canvas:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }

  /* Legendas dos dois lados do arco, como numa prancha */
  .mr-cap {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    gap: 0.4rem;
    pointer-events: none;
    max-width: 22%;
  }
  .mr-cap--left {
    left: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
  }
  .mr-cap--right {
    right: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    text-align: right;
    justify-items: end;
  }
  .mr-idx,
  .mr-group {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .mr-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    line-height: 1.05;
    color: var(--ink);
  }
  .mr-text {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .mr-title,
  .mr-text {
    animation: mr-in 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @keyframes mr-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .mr-nav {
    position: absolute;
    right: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mr-count {
    min-width: 4rem;
    text-align: center;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .mr-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .mr-btn:hover {
    border-color: var(--ink);
  }
  .mr-btn:active {
    transform: scale(0.92);
  }
  .mr-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Celular: o anel ocupa o palco e as legendas vão para baixo dele */
  @media (max-width: 899px) {
    .mr-stage {
      height: auto;
      display: none;
      flex-direction: column;
    }
    .mr.is-gl .mr-stage {
      display: flex;
    }
    .mr-canvas {
      position: relative;
      height: clamp(380px, 60vh, 480px);
    }
    .mr-cap {
      position: static;
      transform: none;
      max-width: none;
      padding-inline: 1.25rem;
      text-align: center;
      justify-items: center;
    }
    .mr-cap--left {
      margin-top: 0.75rem;
    }
    .mr-cap--right {
      margin-top: 0.5rem;
    }
    .mr-text {
      max-width: 34ch;
    }
    .mr-nav {
      position: static;
      justify-content: center;
      margin-top: 1rem;
    }
  }

  /* Lista: grade comum sem o anel; só para leitores de tela com ele */
  .mr-list {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--gutter);
    max-width: calc(var(--max) + 2 * var(--gutter));
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .mr-list li {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.25rem 1rem;
    border-radius: 6px;
    background: var(--white);
    text-align: center;
    font-size: var(--fs-sm);
  }
  .mr-list img {
    width: 88px;
    height: 88px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .mr-li-idx {
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .mr-li-meta {
    color: var(--ink-2);
    font-size: 0.8125rem;
  }
  .mr.is-gl .mr-list {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .mr-title,
    .mr-text {
      animation: none;
    }
  }
</style>

<script>
  import { initMoltenRing } from '../scripts/moltenring';
  initMoltenRing();
</script>
