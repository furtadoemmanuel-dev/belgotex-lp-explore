---
import WaLink from './WaLink.astro';
import { faq } from '../lib/data';
---

<section id="perguntas" class="section" data-section-id="faq" aria-labelledby="perguntas-title">
  <div class="container grid-12">
    <div class="faq-head">
      <h2 id="perguntas-title">Perguntas frequentes</h2>
      <p class="muted">Não encontrou o que procurava?</p>
      <WaLink location="faq" class="link-arrow" />
    </div>
    <div class="faq-list">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <div class="answer">
            <p>{item.a}</p>
            {item.cta === 'consultant' && <WaLink location="faq_answer" class="link-arrow" />}
            {item.cta === 'sample' && (
              <a
                class="link-arrow"
                href="#amostra"
                data-sample-open
                data-cta="sample"
                data-cta-id="sample_faq"
                data-loc="faq"
              >
                Pedir amostras
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .grid-12 {
    row-gap: 2rem;
  }
  .faq-head {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .faq-list {
    grid-column: 1 / -1;
    border-top: 1px solid var(--ink);
  }
  @media (min-width: 900px) {
    .faq-head {
      grid-column: 1 / span 4;
    }
    .faq-list {
      grid-column: 6 / -1;
    }
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    padding: 1.25rem 2.5rem 1.25rem 0;
    font-weight: 600;
    list-style: none;
    position: relative;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0.95rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  .answer {
    padding: 0 0 1.5rem;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    color: var(--ink-2);
  }
  .answer :global(a) {
    color: var(--ink);
  }
  .faq-head :global(svg),
  .answer :global(svg) {
    width: 20px;
    height: 20px;
  }
</style>
