---
import { config } from '../config';
---

<div class="consent" data-consent-bar role="region" aria-label="Preferências de cookies" hidden>
  <p>
    Usamos cookies para medir e melhorar esta página. Nenhuma tag de marketing é ativada sem o seu aceite.{' '}
    <a href={config.cookiesUrl} target="_blank" rel="noopener">
      Saiba mais<span class="sr-only"> sobre a política de cookies (abre em nova aba)</span>
    </a>
  </p>
  <div class="c-actions">
    <button type="button" class="btn btn--primary btn--sm" data-consent="granted">
      Aceitar
    </button>
    <button type="button" class="btn btn--secondary btn--sm" data-consent="denied">
      Recusar
    </button>
  </div>
</div>
<style>
  .consent {
    position: fixed;
    z-index: 60;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(76px + env(safe-area-inset-bottom));
    max-width: 440px;
    background: var(--white);
    border: 1px solid var(--ink);
    padding: 1rem 1.125rem;
    display: grid;
    gap: 0.875rem;
    font-size: var(--fs-sm);
    box-shadow: 0 8px 24px rgb(35 31 32 / 0.12);
  }
  .consent[hidden] {
    display: none;
  }
  @media (min-width: 768px) {
    .consent {
      left: auto;
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }
  .c-actions {
    display: flex;
    gap: 0.5rem;
  }
  .c-actions .btn {
    flex: 1;
  }
</style>
