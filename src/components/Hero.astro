---
import QuoteLink from './QuoteLink.astro';
import TextureCylinder from './TextureCylinder.astro';
import { getImage } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { environmentImages } from '../lib/images';

// Carrossel "abertura": a próxima foto abre num círculo a partir do clique (src/scripts/aperture.ts)
const slides = [
  {
    id: 'capa-cachoeira',
    caption: 'Explore · novos horizontes sob seus pés',
    alt: 'Poltronas sobre carpete Explore diante de uma cachoeira, imagem conceitual da coleção',
    pos: '50% 78%',
  },
  {
    id: 'lobby-odyssey-403-frontier-203',
    caption: 'Lobby · Odyssey 403 + Frontier 203',
    alt: 'Lobby corporativo com carpete Explore em azul claro, combinando dois designs',
    pos: '50% 60%',
  },
  {
    id: 'recepcao-frontier-202-adventure-302',
    caption: 'Recepção · Frontier 202 + Adventure 302',
    alt: 'Recepção com balcão branco e carpete Explore em tons de marrom',
    pos: '50% 60%',
  },
  {
    id: 'lounge-horizon-608-609',
    caption: 'Lounge · Horizon 608 + 609',
    alt: 'Lounge com sofás orgânicos e faixa curva de carpete verde-oliva',
    pos: '50% 50%',
  },
  {
    id: 'open-office-adventure-305',
    caption: 'Open office · Adventure 305',
    alt: 'Open office com estações brancas e carpete Explore cinza',
    pos: '50% 60%',
  },
  {
    id: 'diretoria-navigator-506',
    caption: 'Diretoria · Navigator 506',
    alt: 'Sala de diretoria com carpete Explore grafite',
    pos: '50% 55%',
  },
];
const widths = [640, 960, 1280, 1600, 1920, 2400];
const [first, ...rest] = slides;
// Celular: o hero é bem mais alto que largo; ali entra um recorte vertical (1:2) feito da foto original
const PHONE = '(max-width: 639px)';
const portrait = async (id: string, format: 'avif' | 'webp') => {
  const crops = await Promise.all(
    [560, 800].map((w) =>
      getImage({
        src: environmentImages[id]!,
        width: w,
        height: w * 2,
        fit: 'cover',
        format,
        quality: format === 'avif' ? 48 : 58,
      }),
    ),
  );
  return crops.map((c, i) => `${c.src} ${[560, 800][i]}w`).join(', ');
};
const ok = (id: string) => widths.filter((w) => w <= environmentImages[id]!.width);
const SIZES = '(orientation: portrait) 150vh, 100vw';
const firstImg = {
  phoneAvif: await portrait(first!.id, 'avif'),
  phoneWebp: await portrait(first!.id, 'webp'),
  avif: await getImage({ src: environmentImages[first!.id]!, widths: ok(first!.id), format: 'avif', quality: 70 }),
  webp: await getImage({ src: environmentImages[first!.id]!, widths: ok(first!.id), format: 'webp', quality: 72 }),
};
const restImgs = await Promise.all(
  rest.map(async (s) => ({
    ...s,
    phoneAvif: await portrait(s.id, 'avif'),
    phone: await portrait(s.id, 'webp'),
    img: await getImage({ src: environmentImages[s.id]!, widths: ok(s.id), format: 'webp', quality: 72 }),
  })),
);
const pad2 = (n: number) => String(n).padStart(2, '0');
---

<section id="inicio" class="hero" data-section-id="hero" aria-labelledby="hero-title">
  <div
    class="stage"
    data-aperture
    data-autoplay="6500"
    data-duration="1100"
    data-morph="1500"
    data-captions={JSON.stringify(slides.map((s) => s.caption))}
  >
    <div
      class="ap-slides"
      role="group"
      aria-roledescription="carrossel"
      aria-label="Ambientes com carpete Explore"
    >
      <div class="ap-slide is-current" style={`--pos:${first!.pos}`}>
        <picture>
          <source media={PHONE} type="image/avif" srcset={firstImg.phoneAvif} sizes="100vw" />
          <source media={PHONE} type="image/webp" srcset={firstImg.phoneWebp} sizes="100vw" />
          <source type="image/avif" srcset={firstImg.avif.srcSet.attribute} sizes={SIZES} />
          <img
            src={firstImg.webp.src}
            srcset={firstImg.webp.srcSet.attribute}
            sizes={SIZES}
            alt={first!.alt}
            width={environmentImages[first!.id]!.width}
            height={environmentImages[first!.id]!.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      {restImgs.map((s) => (
        <div class="ap-slide" style={`--pos:${s.pos}`}>
          <picture>
            <source media={PHONE} type="image/avif" data-srcset={s.phoneAvif} sizes="100vw" />
            <source media={PHONE} type="image/webp" data-srcset={s.phone} sizes="100vw" />
            <img
              data-srcset={s.img.srcSet.attribute}
              data-src={s.img.src}
              sizes={SIZES}
              alt={s.alt}
              decoding="async"
            />
          </picture>
        </div>
      ))}
    </div>
    <div class="ap-ring" aria-hidden="true"></div>
    <div class="ap-shade" aria-hidden="true"></div>
    <!-- Cursor de placas: três placas 50 × 50 que seguem o mouse com atrasos diferentes (a do meio
         girada 90°, como na instalação tecelagem); a da frente leva a seta de próximo / anterior -->
    <div class="ap-cursor" aria-hidden="true">
      <span class="ap-tile ap-tile--3"></span>
      <span class="ap-tile ap-tile--2"></span>
      <span class="ap-tile ap-tile--1">
        <svg viewBox="0 0 24 24" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.6" d="M4 12h15m-6-6 6 6-6 6"></path>
        </svg>
      </span>
      <span class="ap-cursor-label">Próximo</span>
    </div>

    <div class="container stage-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Novo carpete modular Belgotex</p>
        <h1 id="hero-title">
          <span class="rise hero-name">
            <span>Explore</span>
          </span>
          <span class="rise hero-tagline">
            <span>Novos horizontes sob seus pés.</span>
          </span>
        </h1>
        <p class="lead">
          Seis designs, 9 cores e infinitas possibilidades pensados para funcionar juntos. Carpete modular de uso comercial pesado para
          escritórios, recepções e lobbies: combine, crie e especifique.
        </p>
        <ul class="facts" aria-label="Destaques">
          <li>
            <span>
              <strong>Uso 33</strong>, comercial pesado
            </span>
          </li>
          <li>
            <span>
              Placas de <strong>50 × 50 cm</strong>
            </span>
          </li>
        </ul>
        <div class="actions">
          <QuoteLink class="btn btn--light" loc="hero" />
          <a
            class="btn btn--ghost"
            href="#combine"
            data-cta="composer"
            data-cta-id="composer_hero"
            data-loc="hero"
          >
            Montar uma composição
          </a>
        </div>
        <Logo class="hero-logo" />
      </div>

      <div class="ap-bar">
        <p class="ap-caption small" data-ap-live aria-live="off">
          <span class="rise">
            <span data-ap-caption>{first!.caption}</span>
          </span>
        </p>
        <div class="ap-ctrl">
          <span class="ap-count" aria-hidden="true">
            <span data-ap-index>01</span> — {pad2(slides.length)}
          </span>
          <button type="button" class="ap-btn" data-ap-prev aria-label="Ambiente anterior">
            <Icon name="prev" />
          </button>
          <button
            type="button"
            class="ap-btn"
            data-ap-pause
            aria-label="Pausar troca de ambientes"
            aria-pressed="false"
          >
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="1.6" d="M9 5v14M15 5v14"></path>
            </svg>
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="1.6" d="M8 5v14l11-7Z"></path>
            </svg>
          </button>
          <button type="button" class="ap-btn" data-ap-next aria-label="Próximo ambiente">
            <Icon name="next" />
          </button>
        </div>
        <div class="ap-track" aria-hidden="true">
          <div class="ap-fill"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <TextureCylinder />
  </div>
</section>

<style>
  .hero {
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  /* Palco em tela cheia com as fotos dos ambientes */
  .stage {
    --ap-ink: #fff;
    --ap-dur: 6500ms;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #1a1716;
    color: var(--ap-ink);
    min-height: calc(100svh - 68px);
    display: flex;
    align-items: flex-end;
    touch-action: pan-y;
  }
  @media (hover: hover) and (pointer: fine) {
    .stage.lens-on {
      cursor: none;
    }
  }
  .ap-slides,
  .ap-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .ap-slide {
    visibility: hidden;
  }
  .ap-slide.is-current {
    visibility: visible;
    z-index: 0;
  }
  .ap-slide.is-incoming {
    visibility: visible;
    z-index: 1;
  }
  .ap-slide :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }
  /* Canvas do morph (src/scripts/morph.ts): criado na primeira troca, fica por cima das fotos só durante ela */
  .ap-slides :global(.ap-morph) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    visibility: hidden;
  }
  .ap-slides :global(.ap-morph.on) {
    visibility: visible;
  }
  .ap-ring {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    border-radius: 50%;
    border: 1px solid var(--ap-ink);
    pointer-events: none;
    opacity: 0;
  }
  .ap-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    /* No celular o texto ocupa quase todo o hero, até o alto da foto: a película cobre a altura toda */
    background: linear-gradient(
      to top,
      rgba(20, 17, 16, 0.88) 0%,
      rgba(20, 17, 16, 0.64) 48%,
      rgba(20, 17, 16, 0.4) 78%,
      rgba(20, 17, 16, 0.5) 100%
    );
  }
  @media (min-width: 900px) {
    .ap-shade {
      background:
        linear-gradient(90deg, rgba(20, 17, 16, 0.72) 0%, rgba(20, 17, 16, 0.4) 42%, rgba(20, 17, 16, 0) 68%),
        linear-gradient(to top, rgba(20, 17, 16, 0.7) 0%, rgba(20, 17, 16, 0) 45%);
    }
  }
  .ap-cursor {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .stage.lens-on .ap-cursor {
    opacity: 1;
  }
  .ap-tile {
    position: absolute;
    left: 0;
    top: 0;
    width: 54px;
    height: 54px;
    margin: -27px 0 0 -27px;
    border: 1px solid var(--ap-ink);
    border-radius: 3px;
    will-change: transform;
  }
  .ap-tile--1 {
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .ap-tile--1 svg {
    width: 22px;
    height: 22px;
    transition: transform 0.45s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .stage[data-cursor-dir='prev'] .ap-tile--1 svg {
    transform: rotate(180deg);
  }
  /* As placas de trás têm o fio do carpete riscado: girada 90°, a do meio mostra a tecelagem */
  .ap-tile--2,
  .ap-tile--3 {
    background: repeating-linear-gradient(
      0deg,
      rgb(255 255 255 / 0.4) 0 1px,
      transparent 1px 5px
    );
  }
  .ap-tile--2 {
    opacity: 0.7;
  }
  .ap-tile--3 {
    opacity: 0.4;
  }
  .ap-cursor-label {
    position: absolute;
    left: 0;
    top: 0;
    margin: 36px 0 0 -40px;
    width: 80px;
    text-align: center;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.5);
    will-change: transform;
  }
  .stage.is-pressed .ap-tile--1 {
    scale: 0.82;
  }
  .ap-tile--1 {
    transition: scale 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .stage-inner {
    position: relative;
    z-index: 3;
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-top: clamp(5rem, 18vh, 10rem);
    padding-bottom: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }
  .hero-copy {
    display: grid;
    gap: 1.5rem;
    max-width: 62rem;
  }
  .hero-copy > :not(h1) {
    max-width: 38rem;
  }
  .hero-copy h1 {
    color: #fff;
  }
  .hero-copy :global(.hero-logo) {
    justify-self: start;
    height: clamp(26px, 1.6vw + 18px, 36px);
    color: #fff;
    margin-top: -0.25rem;
  }
  .hero-eyebrow {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: -0.75rem;
  }
  /* Hierarquia: categoria (eyebrow) → nome do produto → assinatura da marca (CAT p.1) → texto de apoio */
  .hero-name {
    font-size: clamp(3.5rem, 1.6rem + 9vw, 10.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    padding-bottom: 0.12em;
  }
  .hero-tagline {
    margin-top: clamp(0.25rem, 0.1rem + 0.6vw, 0.75rem);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    line-height: 1.08;
    color: rgba(255, 255, 255, 0.94);
  }
  .hero-copy .lead {
    color: rgba(255, 255, 255, 0.86);
  }

  /* Títulos que sobem de dentro de uma máscara */
  .rise {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .rise > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rise > span {
      animation: rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .hero-tagline > span {
      animation-delay: 0.12s;
    }
    @keyframes rise {
      from {
        transform: translateY(105%);
      }
      to {
        transform: none;
      }
    }
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
  }
  /* Travessão colado ao texto (mesmo espaço em todos os itens) e mais ar entre um item e outro */
  .facts li {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .facts li::before {
    content: '';
    flex: none;
    width: 0.875em;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  /* Botões em versão clara sobre a foto */
  .stage :global(.btn--light) {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  .stage :global(.btn--light:hover) {
    background: var(--paper);
  }
  .stage :global(.btn--ghost) {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.9);
    color: #fff;
  }
  .stage :global(.btn--ghost:hover) {
    background: #fff;
    color: var(--ink);
  }
  .stage :focus-visible {
    outline-color: #fff;
  }


  /* Barra do carrossel: legenda, contador, controles e a linha de progresso */
  .ap-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .ap-caption {
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.02em;
  }
  .ap-ctrl {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .ap-count {
    font:
      500 0.75rem/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.14em;
    margin-right: 0.5rem;
    white-space: nowrap;
  }
  .ap-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .ap-btn:hover {
    border-color: #fff;
  }
  .ap-btn :global(svg) {
    width: 18px;
    height: 18px;
  }
  .ap-btn .i-play,
  .ap-btn[aria-pressed='true'] .i-pause {
    display: none;
  }
  .ap-btn[aria-pressed='true'] .i-play {
    display: block;
  }
  .stage[data-static] [data-ap-pause] {
    display: none;
  }
  .ap-track {
    grid-column: 1 / -1;
    height: 1px;
    background: rgba(255, 255, 255, 0.28);
  }
  .ap-fill {
    height: 100%;
    background: var(--ap-ink);
    transform-origin: left;
    transform: scaleX(0);
  }
  .ap-fill.run {
    animation: ap-fill var(--ap-dur) linear forwards;
  }
  .stage[data-paused] .ap-fill {
    animation-play-state: paused;
  }
  @keyframes ap-fill {
    to {
      transform: scaleX(1);
    }
  }
</style>
