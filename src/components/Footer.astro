---
// Rodapé em duas partes, num único <footer>:
// 1. A "cortina" (adaptada do componente CinematicFooter, sem React, Tailwind nem GSAP): uma tela fixa por
//    baixo da página, vista por uma janela (clip-path) que passa pela tela durante a rolagem.
// 2. A "folha" institucional no modelo do belgotex.com.br, fechando a LP: logo, endereço, redes, colunas de
//    links e o aviso "Importante". Tem os cantos de cima arredondados e sobe por cima da cortina. Grade de placas 50 × 50 ao fundo, faixa
//    diagonal com os atributos do Explore, "Explore" gigante que sobe com a rolagem e os botões finais
//    (cotação, amostras, consultor) com efeito magnético. Script em src/scripts/footer.ts.
import Logo from './Logo.astro';
import WaLink from './WaLink.astro';
import { config } from '../config';
import { documents } from '../lib/data';
import facebook from '@tabler/icons/outline/brand-facebook.svg?raw';
import instagram from '@tabler/icons/outline/brand-instagram.svg?raw';
import linkedin from '@tabler/icons/outline/brand-linkedin.svg?raw';
import youtube from '@tabler/icons/outline/brand-youtube.svg?raw';
import pinterest from '@tabler/icons/outline/brand-pinterest.svg?raw';
import phoneIcon from '@tabler/icons/outline/phone.svg?raw';
import mailIcon from '@tabler/icons/outline/mail.svg?raw';
import QuoteLink from './QuoteLink.astro';

const icon = (raw: string) =>
  raw.replace(/\sclass="[^"]*"/, '').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const year = new Date().getFullYear();
const site = config.mainSiteUrl.replace(/\/$/, '');
const catalog = documents.find((d) => d.id === 'catalogo');
const social = [
  { label: 'Facebook', url: 'https://www.facebook.com/belgotexdobrasil', svg: facebook },
  { label: 'Instagram', url: 'https://www.instagram.com/belgotexdobrasil/', svg: instagram },
  { label: 'LinkedIn', url: 'https://br.linkedin.com/company/belgotex-do-brasil', svg: linkedin },
  { label: 'YouTube', url: 'https://www.youtube.com/channel/UCvy16AJJasAW9kAwxg3Usjw', svg: youtube },
  { label: 'Pinterest', url: 'https://br.pinterest.com/belgotexdobrasil', svg: pinterest },
];
const info = [
  { label: 'Sobre nós', url: `${site}/quem-somos` },
  { label: 'Trabalhe conosco', url: `${site}/trabalhe-conosco` },
  { label: 'Entre em contato', url: `${site}/contato` },
  { label: 'Sustentabilidade', url: 'https://blife.belgotex.com.br/' },
];
const policies = [
  { label: 'Política de Privacidade', url: config.privacyUrl },
  { label: 'Política de Cookies', url: config.cookiesUrl },
  { label: 'Código de Ética', url: `${site}/codigo-de-etica` },
];
// Só atributos que já estão na página (catálogo e ficha): nada de dado novo aqui
const marquee = [
  'Carpete modular 50 × 50 cm',
  '6 designs',
  '9 cores',
  'Uso 33, comercial pesado',
  'Tratamento antimicrobiano',
  'Fabricado com orgulho no Brasil',
];
---

<footer class="footer" data-section-id="footer">
  <!-- Cortina: o recorte (clip-path) só deixa a tela fixa aparecer dentro desta caixa -->
  <div class="f-curtain" data-f-curtain>
    <div class="f-stage" data-f-stage>
      <div class="f-aurora" aria-hidden="true"></div>
      <div class="f-grid" aria-hidden="true"></div>
      <div class="f-giant" aria-hidden="true" data-f-giant>Explore</div>

      <div class="f-marquee" aria-hidden="true">
        <div class="f-marquee-track">
          {[0, 1].map(() => (
            <div class="f-marquee-set">
              {marquee.map((m) => (
                <>
                  <span>{m}</span>
                  <span class="f-star">✦</span>
                </>
              ))}
            </div>
          ))}
        </div>
      </div>
      <p class="sr-only">{marquee.join(', ')}.</p>

      <div class="f-center">
        <h2 class="f-heading" data-f-heading>Pronto para explorar?</h2>
        <div class="f-links" data-f-links>
          <div class="f-row">
            <QuoteLink class="f-pill f-pill--lg f-pill--solid" loc="footer" data-magnetic>
              Solicitar cotação
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 12h15m-6-6 6 6-6 6" />
              </svg>
            </QuoteLink>
            <button
              type="button"
              class="f-pill f-pill--lg"
              data-magnetic
              data-sample-open
              data-loc="footer"
              data-cta="sample"
              data-cta-id="sample_footer"
            >
              Pedir amostras
            </button>
          </div>
          <div class="f-row">
            <WaLink location="footer" class="f-pill" icon={true} />
            <a class="f-pill" href="#combine" data-magnetic data-cta="composer" data-cta-id="composer_footer" data-loc="footer">
              Montar uma composição
            </a>
            {catalog && (
              <a
                class="f-pill"
                href={catalog.url}
                target="_blank"
                rel="noopener"
                data-magnetic
                data-doc="catalogo"
                data-cta="document"
                data-cta-id="document_catalogo_footer"
                data-loc="footer"
              >
                E-catálogo
                <span class="sr-only"> (abre em nova aba)</span>
              </a>
            )}
          </div>
        </div>
      </div>

      <div class="f-bar">
        <p class="f-copy">© {year} Belgotex do Brasil. Todos os direitos reservados.</p>
        <p class="f-badge">
          <span class="f-tile" aria-hidden="true"></span>
          Fabricado com orgulho no Brasil
        </p>
        <button type="button" class="f-top" data-magnetic data-f-top aria-label="Voltar ao início da página">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0 7 7m-7-7v18" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="f-sheet">
    <div class="container top">
      <div class="f-brand">
        <a href={config.mainSiteUrl} class="f-logo-link" target="_blank" rel="noopener">
          <Logo class="f-logo" />
          <span class="sr-only">Belgotex do Brasil, site oficial (abre em nova aba)</span>
        </a>
        <p class="f-address">
          Belgotex do Brasil Indústria de Carpetes LTDA.
          <br />
          CNPJ: 02.305.606/0001-60
        </p>
        <p class="f-address">
          CEP: 84043-737 | Avenida José Carlos Gomes
          <br />
          Ponta Grossa - PR | Brasil
        </p>
        <ul class="social" aria-label="Redes sociais da Belgotex">
          {social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.label} (abre em nova aba)`}>
                <Fragment set:html={icon(s.svg)} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="cols">
        <nav class="f-col" aria-labelledby="f-info">
          <h2 class="f-title" id="f-info">Informações</h2>
          <ul>
            {info.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener">
                  {l.label}
                  <span class="sr-only"> (abre em nova aba)</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="f-col" aria-labelledby="f-policies">
          <h2 class="f-title" id="f-policies">Políticas de uso</h2>
          <ul>
            {policies.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener">
                  {l.label}
                  <span class="sr-only"> (abre em nova aba)</span>
                </a>
              </li>
            ))}
            <li>
              <button type="button" class="linklike" data-consent-reopen>
                Preferências de cookies
              </button>
            </li>
          </ul>
        </nav>
        <div class="f-col">
          <h2 class="f-title">Contatos</h2>
          <ul>
            <li>
              <a href="tel:+554221011000" class="with-icon">
                <Fragment set:html={icon(phoneIcon)} />
                (42) 2101-1000
              </a>
            </li>
            <li>
              <a href="mailto:contato@belgotex.com.br" class="with-icon">
                <Fragment set:html={icon(mailIcon)} />
                contato@belgotex.com.br
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="legal">
      <div class="container">
        <p class="legal-title">Importante.</p>
        <p>
          Devido à diferença das telas, monitores, TVs e dos sistemas operacionais dos computadores, não
          garantimos que a cor dos produtos seja uma verdadeira indicação do produto acabado. As cores e
          texturas apresentadas podem ser diferentes do produto real. Recomendamos a visualização de uma
          amostra física para obter uma verdadeira indicação da cor: solicite a sua pelo formulário desta
          página. As especificações técnicas podem variar dentro das tolerâncias normais de fabricação, sem
          afetar a qualidade e o desempenho.
        </p>
      </div>
    </div>
  </div>

</footer>

<style>
  .footer {
    --f-curtain-bg: #15181d;
    --f-fg: #f4f1ec;
    --f-muted: #b9bec6;
    --f-radius: 28px;
    color: #c2c6cc;
    font-size: var(--fs-sm);
    background: var(--f-curtain-bg);
  }

  /* 1. Folha institucional */
  .f-sheet {
    position: relative;
    z-index: 1;
    margin-top: calc(var(--f-radius) * -1); /* sobe por cima do fim da cortina */
    background: var(--slate);
    border-radius: var(--f-radius) var(--f-radius) 0 0;
    box-shadow: 0 -30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .top {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 600px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      align-items: start;
    }
  }
  .f-brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .f-logo-link {
    display: inline-block;
    width: max-content;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .f-logo-link :global(.f-logo) {
    height: 36px;
  }
  .f-address {
    line-height: 1.8;
    max-width: none;
  }
  .social {
    list-style: none;
    margin: 0 0 0 -10px;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }
  .social a {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: #fff;
    border-radius: 50%;
  }
  .social a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .social :global(svg) {
    width: 20px;
    height: 20px;
  }
  .f-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0;
    margin-bottom: 0.5rem;
  }
  .f-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .f-col a,
  .linklike {
    color: #c2c6cc;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-sm);
  }
  .f-col a:hover,
  .linklike:hover {
    color: #fff;
    text-decoration: underline;
  }
  .with-icon {
    gap: 0.5rem;
  }
  .with-icon :global(svg) {
    width: 16px;
    height: 16px;
    color: #fff;
  }
  .linklike {
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .footer :focus-visible {
    outline-color: #fff;
  }
  .legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 2rem calc(2.75rem + env(safe-area-inset-bottom));
  }
  .legal {
    text-align: center;
    color: #cfd3d9;
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  .legal p {
    max-width: 62rem;
    margin-inline: auto;
  }
  .legal-title {
    font-weight: 700;
    font-size: var(--fs-sm);
    color: #c2c6cc;
  }

  /* 2. Cortina: a caixa recorta; a tela de dentro fica fixa na janela */
  .f-curtain {
    position: relative;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }
  .f-stage {
    position: fixed;
    inset: auto 0 0 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: var(--f-curtain-bg);
    color: var(--f-fg);
  }
  /* Tela baixa (celular deitado): sem tela fixa, a cortina vira um bloco comum */
  @media (max-height: 599px) {
    .f-curtain {
      height: auto;
      clip-path: none;
    }
    .f-stage {
      position: relative;
      height: auto;
      min-height: 600px;
      padding-bottom: var(--f-radius);
    }
  }

  .f-aurora {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 90vw;
    height: 70vh;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(236 229 216 / 0.13) 0%,
      rgb(62 75 87 / 0.35) 45%,
      transparent 100%
    );
    transform: translate(-50%, -50%);
    animation: f-breathe 8s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes f-breathe {
    from {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.6;
    }
    to {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 1;
    }
  }
  /* A grade lembra as placas de 50 × 50 cm */
  .f-grid {
    position: absolute;
    inset: 0;
    background-size: 64px 64px;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
    pointer-events: none;
  }
  .f-giant {
    position: absolute;
    left: 50%;
    bottom: -0.06em;
    font-family: var(--font-display);
    font-size: 26vw;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.07);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.11) 0%, transparent 65%);
    -webkit-background-clip: text;
    background-clip: text;
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    pointer-events: none;
    user-select: none;
    will-change: transform, opacity;
  }

  .f-marquee {
    position: absolute;
    top: calc(68px + 2rem); /* abaixo do cabeçalho fixo */
    left: -5%;
    width: 110%;
    z-index: 2;
    overflow: hidden;
    padding-block: 1rem;
    border-block: 1px solid rgb(255 255 255 / 0.1);
    /* sem desfoque de vidro: o fundo aqui é liso e escuro, e o desfoque numa camada fixa só pesaria */
    background: rgb(21 24 29 / 0.85);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
    transform: rotate(-2deg);
  }
  .f-marquee-track {
    display: flex;
    width: max-content;
    animation: f-marquee 40s linear infinite;
  }
  .f-marquee-set {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-inline: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--f-muted);
    white-space: nowrap;
  }
  .f-star {
    color: rgb(236 229 216 / 0.55);
  }
  @keyframes f-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (min-width: 768px) {
    .f-marquee-set {
      font-size: 0.8125rem;
    }
  }

  .f-center {
    position: relative;
    z-index: 3;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 64rem;
    margin: calc(68px + 5.5rem) auto 0;
    padding-inline: 1.5rem;
  }
  .f-heading {
    margin: 0 0 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.5rem + 6vw, 6.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--f-fg);
    background: linear-gradient(180deg, #fff 0%, rgb(244 241 236 / 0.62) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 20px rgb(255 255 255 / 0.12));
  }
  .f-links {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    width: 100%;
  }
  .f-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .f-row {
      gap: 1rem;
    }
  }

  /* Pílulas de vidro com efeito magnético (o transform vem do script) */
  .f-curtain :global(.f-pill) {
    --pill-1: rgb(255 255 255 / 0.05);
    --pill-2: rgb(255 255 255 / 0.015);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.6rem 1.4rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    background: linear-gradient(145deg, var(--pill-1), var(--pill-2));
    box-shadow:
      0 10px 30px -10px rgb(0 0 0 / 0.5),
      inset 0 1px 1px rgb(255 255 255 / 0.1),
      inset 0 -1px 2px rgb(0 0 0 / 0.6);
    color: var(--f-muted);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .f-curtain :global(.f-pill:hover) {
    --pill-1: rgb(255 255 255 / 0.11);
    --pill-2: rgb(255 255 255 / 0.03);
    border-color: rgb(255 255 255 / 0.25);
    box-shadow:
      0 20px 40px -10px rgb(0 0 0 / 0.7),
      inset 0 1px 1px rgb(255 255 255 / 0.2);
    color: #fff;
  }
  .f-curtain :global(.f-pill svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .f-curtain :global(.f-pill--lg) {
    min-height: 56px;
    padding: 0.9rem 2.25rem;
    color: var(--f-fg);
    font-size: 1rem;
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .f-curtain :global(.f-pill--lg) {
      min-height: 64px;
      padding-inline: 2.75rem;
    }
  }
  .f-curtain :global(.f-pill--solid) {
    --pill-1: #f4f1ec;
    --pill-2: #e3ddd2;
    border-color: transparent;
    color: var(--ink);
  }
  .f-curtain :global(.f-pill--solid:hover) {
    --pill-1: #fff;
    --pill-2: #ece5d8;
    color: var(--ink);
  }
  .f-curtain :focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .f-bar {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* o fim da cortina fica por baixo dos cantos da folha */
    padding: 2rem 1.5rem calc(1.75rem + var(--f-radius));
  }
  @media (min-width: 768px) {
    .f-bar {
      flex-direction: row;
      padding-inline: 3rem;
    }
  }
  .f-copy {
    order: 2;
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--f-muted);
    text-align: center;
  }
  .f-badge {
    order: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.6rem 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--f-muted);
  }
  /* Uma plaquinha 50 × 50 que pulsa, no lugar do coração do original */
  .f-tile {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: #ece5d8;
    animation: f-beat 2s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }
  @keyframes f-beat {
    0%,
    30%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 5px rgb(236 229 216 / 0.4);
    }
    15%,
    45% {
      transform: scale(1.3) rotate(45deg);
      box-shadow: 0 0 10px rgb(236 229 216 / 0.7);
    }
  }
  .f-top {
    order: 3;
    display: grid;
    place-items: center;
